# Retail Spatial Intelligence Platform - Environment Configuration

# Server Ports
PORT=5000
BACKEND_PORT=5000
CV_SERVICE_URL=http://localhost:8000

# Groq API Configuration for Retail AI Analytics Report
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Storage & Persistence
# Optional: if MONGODB_URI is left empty, the platform automatically persists to local JSON store
MONGODB_URI=

# Video Processing Defaults
DEFAULT_MAX_DIMENSION=960
DEFAULT_FRAME_SKIP=2
YOLO_MODEL=yolov8n.pt
